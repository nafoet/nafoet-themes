	"tokenColors": [{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#B0BEC5",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"constant",
				"entity.name.constant",
				"variable.other.constant",
				"variable.language"
			],
			"settings": {
				"foreground": "#FF9800"
			}
		},
		{
			"scope": [
				"entity",
				"entity.name",
				"entity.name.type",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#03A9F4"
			}
		},
		{
			"scope": "keyword",
			"settings": {
				"foreground": "#E91E63",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"storage",
				"storage.type"
			],
			"settings": {
				"foreground": "#FF9800"
			}
		},
		{
			"scope": [
				"string",
				"punctuation.definition.string",
				"string punctuation.section.embedded source"
			],
			"settings": {
				"foreground": "#4CAF50"
			}
		},
		{
			"scope": "support",
			"settings": {
				"foreground": "#00BCD4"
			}
		},
		{
			"scope": [
				"variable",
				"variable.parameter"
			],
			"settings": {
				"foreground": "#F44336"
			}
		},
		{
			"scope": "invalid",
			"settings": {
				"foreground": "#F44336",
				"fontStyle": "underline"
			}
		}
	]
}