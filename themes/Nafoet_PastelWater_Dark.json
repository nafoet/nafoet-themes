{
	"$schema": "vscode://schemas/color-theme",
	"name": "Nafoet PastelWater",
	"type": "dark",
	"semanticHighlighting": true,
	"tokenColors": [
		{
			"settings": {
				"foreground": "#e0983d"
			}
		},
		{
			"scope": "emphasis",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "strong",
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": "header",
			"settings": {
				"foreground": "#3a7476"
			}
		},
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#a27771",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"constant",
				"support.constant",
				"variable.arguments"
			],
			"settings": {
				"foreground": "#fabc89"
			}
		},
		{
			"scope": "constant.rgb-value",
			"settings": {
				"foreground": "#e0983d"
			}
		},
		{
			"scope": "entity.name.selector",
			"settings": {
				"foreground": "#fabc89"
			}
		},
		{
			"scope": "entity.other.attribute-name",
			"settings": {
				"foreground": "#c8b5a6"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"punctuation.tag"
			],
			"settings": {
				"foreground": "#fabc89"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#a8352e"
			}
		},
		{
			"scope": "invalid.deprecated",
			"settings": {
				"foreground": "#a27771"
			}
		},
		{
			"scope": "meta.selector",
			"settings": {
				"foreground": "#fabc89"
			}
		},
		{
			"scope": "meta.preprocessor",
			"settings": {
				"foreground": "#f66953"
			}
		},
		{
			"scope": "meta.preprocessor.string",
			"settings": {
				"foreground": "#fabc89"
			}
		},
		{
			"scope": "meta.preprocessor.numeric",
			"settings": {
				"foreground": "#fabc89"
			}
		},
		{
			"scope": "meta.header.diff",
			"settings": {
				"foreground": "#f66953"
			}
		},
		{
			"scope": "storage",
			"settings": {
				"foreground": "#f66953"
			}
		},
		{
			"scope": [
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#f66953"
			}
		},
		{
			"scope": "string",
			"settings": {
				"foreground": "#fabc89"
			}
		},
		{
			"scope": "string.tag",
			"settings": {
				"foreground": "#fabc89"
			}
		},
		{
			"scope": "string.value",
			"settings": {
				"foreground": "#fabc89"
			}
		},
		{
			"scope": "string.regexp",
			"settings": {
				"foreground": "#f66953"
			}
		},
		{
			"scope": "string.escape",
			"settings": {
				"foreground": "#f66953"
			}
		},
		{
			"scope": "string.quasi",
			"settings": {
				"foreground": "#fabc89"
			}
		},
		{
			"scope": "string.entity",
			"settings": {
				"foreground": "#fabc89"
			}
		},
		{
			"scope": "object",
			"settings": {
				"foreground": "#e0983d"
			}
		},
		{
			"scope": "module.node",
			"settings": {
				"foreground": "#f0ad4e"
			}
		},
		{
			"scope": "support.type.property-name",
			"settings": {
				"foreground": "#f0ad4e"
			}
		},
		{
			"scope": "keyword",
			"settings": {
				"foreground": "#f66953"
			}
		},
		{
			"scope": "keyword.control",
			"settings": {
				"foreground": "#f66953"
			}
		},
		{
			"scope": "keyword.control.module",
			"settings": {
				"foreground": "#fabc89"
			}
		},
		{
			"scope": "keyword.control.less",
			"settings": {
				"foreground": "#fa805e"
			}
		},
		{
			"scope": "keyword.operator",
			"settings": {
				"foreground": "#fabc89"
			}
		},
		{
			"scope": "keyword.operator.new",
			"settings": {
				"foreground": "#f66953"
			}
		},
		{
			"scope": "keyword.other.unit",
			"settings": {
				"foreground": "#fabc89"
			}
		},
		{
			"scope": "metatag.php",
			"settings": {
				"foreground": "#f66953"
			}
		},
		{
			"scope": "support.function.git-rebase",
			"settings": {
				"foreground": "#f0ad4e"
			}
		},
		{
			"scope": "constant.sha.git-rebase",
			"settings": {
				"foreground": "#fabc89"
			}
		},
		{
			"name": "Types declaration and references",
			"scope": [
				"meta.type.name",
				"meta.return.type",
				"meta.return-type",
				"meta.cast",
				"meta.type.annotation",
				"support.type",
				"storage.type.cs",
				"variable.class"
			],
			"settings": {
				"foreground": "#c8b5a6"
			}
		},
		{
			"scope": [
				"variable.this",
				"support.variable"
			],
			"settings": {
				"foreground": "#fabc89"
			}
		},
		{
			"scope": [
				"entity.name",
				"entity.static",
				"entity.name.class.static.function",
				"entity.name.function",
				"entity.name.class",
				"entity.name.type"
			],
			"settings": {
				"foreground": "#c8b5a6"
			}
		},
		{
			"name": "Function declarations",
			"scope": [
				"entity.function",
				"entity.name.function.static"
			],
			"settings": {
				"foreground": "#fabc89"
			}
		},
		{
			"scope": "entity.name.function.function-call",
			"settings": {
				"foreground": "#fabc89"
			}
		},
		{
			"scope": "support.function.builtin",
			"settings": {
				"foreground": "#f66953"
			}
		},
		{
			"scope": [
				"entity.name.method",
				"entity.name.method.function-call",
				"entity.name.static.function-call"
			],
			"settings": {
				"foreground": "#f0ad4e"
			}
		},
		{
			"scope": "brace",
			"settings": {
				"foreground": "#e0983d"
			}
		},
		{
			"name": "variables",
			"scope": [
				"meta.parameter.type.variable",
				"variable.parameter",
				"variable.name",
				"variable.other",
				"variable",
				"string.constant.other.placeholder"
			],
			"settings": {
				"foreground": "#f0ad4e"
			}
		},
		{
			"scope": "prototype",
			"settings": {
				"foreground": "#fabc89"
			}
		},
		{
			"scope": [
				"punctuation"
			],
			"settings": {
				"foreground": "#fabc89"
			}
		},
		{
			"scope": "punctuation.quoted",
			"settings": {
				"foreground": "#e0983d"
			}
		},
		{
			"scope": "punctuation.quasi",
			"settings": {
				"foreground": "#f66953"
			}
		},
		{
			"name": "URL",
			"scope": [
				"*url*",
				"*link*",
				"*uri*"
			],
			"settings": {
				"fontStyle": "underline"
			}
		},
		// ----------------------------------------
		//            LANGUAGE SPECIFIC
		// ----------------------------------------
		// PYTHON ----------------------------------------
